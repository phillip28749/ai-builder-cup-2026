{
  "name": "asenso-one-studio-poc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "start": "node dist-server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "sheets:init": "tsx scripts/initialize-sheet.ts"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "dotenv": "^18.0.8",
    "express": "^4.21.2",
    "firebase": "^12.14.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.1",
    "googleapis": "^186.0.0",
    "lucide-react": "^0.468.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.2",
    "prettier": "^3.9.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.2.4"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
