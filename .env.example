# Asenso One Studio - backend configuration
# Copy to .env, fill in your settings, then restart npm run dev.
# Keep .env out of Git. Never prefix secrets with VITE_.

# Google sign-in: required for personal workspaces.
# Single-line Firebase web app configuration JSON (see GOOGLE_SIGNIN_SETUP.md).
FIREBASE_WEB_CONFIG=

# Live AI: one backend key serves the app's users.
# Model access depends on your Google project, billing, and quota.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_VIDEO_MODEL=veo-3.1-lite-generate-preview

# Sessions and encrypted connections: use at least 32 random characters.
# Keep stable across restarts/deployments; changing it invalidates saved credentials.
SESSION_SECRET=

# Google Sheets: optional, separate from Google sign-in.
# Configure the app's OAuth client once; each user then connects their account.
# Register this exact callback in the dedicated Sheets OAuth web client.
# See GOOGLE_SHEETS_SETUP.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8088/api/google/sheets/callback

# Development: true exposes the shared editable sample studio without sign-in.
DEMO_MODE=false
# Operator setup instructions in the UI; hidden by default.
SHOW_DEVELOPER_SETUP=false

# Cloud: supplied by scripts/deploy-firebase.ps1.
# Local development uses .data files; leave these commented out.
# Firestore/Cloud Storage require a runtime identity or local Google ADC.
# DATA_BACKEND=firestore
# GOOGLE_CLOUD_PROJECT=your-project-id
# MEDIA_BUCKET=your-private-media-bucket
# PUBLIC_ORIGIN=https://your-project-id.web.app
# PORT=8088

# Optional read-only Facebook Page context. Blank disables the connector.
# Choose a version supported by your Meta app; Page tokens are entered in the app.
# This is not one-click Meta OAuth.
META_GRAPH_VERSION=
