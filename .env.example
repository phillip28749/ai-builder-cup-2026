# Server only. Copy to .env locally; never use a VITE_ prefix for secrets.
# Hide operator setup instructions from the user-facing app by default.
# Set true only while showing developer setup help; restart/redeploy after changes.
SHOW_DEVELOPER_SETUP=false
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_VIDEO_MODEL=veo-3.1-lite-generate-preview
# Optional text model; select a model available to your key/project.
GEMINI_MODEL=
# Required for durable uploaded/generated media on Cloud Run (private GCS bucket).
MEDIA_BUCKET=
# Google account registration/sign-in (public Firebase web app config, not the Gemini key).
FIREBASE_WEB_CONFIG=
# Optional shared sample workspace for development only. Default requires Google sign-in.
DEMO_MODE=false

# Optional per-user Google Sheets authorization (separate from Firebase login).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8088/api/google/sheets/callback
# Stable random secret, >=32 characters; also encrypts per-account OAuth tokens.
SESSION_SECRET=

# Optional read-only Facebook Page context. Choose a version supported by your Meta app.
META_GRAPH_VERSION=
